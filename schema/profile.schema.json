{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaaiuplift.com/schema/profile-r0-v1.json",
  "title": "EA AI Uplift Release 0 profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "headline",
    "bio",
    "workMode",
    "organisation",
    "capabilities",
    "availability",
    "availabilityChecked",
    "site",
    "contact",
    "photo",
    "listingConsent",
    "copyApproved",
    "photoApproved"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "workMode": {
            "const": "independent"
          }
        },
        "required": [
          "workMode"
        ]
      },
      "then": {
        "properties": {
          "organisation": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workMode": {
            "enum": [
              "in-house",
              "both"
            ]
          }
        },
        "required": [
          "workMode"
        ]
      },
      "then": {
        "properties": {
          "organisation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicationBasis": {
            "const": "public-sources-pending-review"
          }
        },
        "required": [
          "publicationBasis"
        ]
      },
      "then": {
        "properties": {
          "listingConsent": {
            "$ref": "#/$defs/notGrantedConsent"
          },
          "copyApproved": {
            "$ref": "#/$defs/notGrantedConsent"
          },
          "photoApproved": {
            "$ref": "#/$defs/notGrantedConsent"
          }
        }
      },
      "else": {
        "properties": {
          "listingConsent": {
            "$ref": "#/$defs/grantedConsent"
          },
          "copyApproved": {
            "$ref": "#/$defs/grantedConsent"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "photo": {
                  "type": "string"
                }
              },
              "required": [
                "photo"
              ]
            },
            "then": {
              "properties": {
                "photoApproved": {
                  "$ref": "#/$defs/grantedConsent"
                }
              }
            },
            "else": {
              "properties": {
                "photoApproved": {
                  "$ref": "#/$defs/notGrantedConsent"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "r0-v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "bio": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "bioSections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "text"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "text": {
            "type": "string",
            "minLength": 20,
            "maxLength": 700
          }
        }
      }
    },
    "workMode": {
      "enum": [
        "in-house",
        "independent",
        "both"
      ]
    },
    "organisation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 140
    },
    "causeAreas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["ea-community-building", "animal-welfare", "global-health-development", "ai-safety-governance", "climate", "philanthropy-grantmaking", "research-data", "cross-cause-support", "other"] }
    },
    "networks": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["aim-charity"] }
    },
    "organisationRelationship": { "enum": ["contractor"] },
    "conversationContact": { "type": "boolean" },
    "directorySources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 12, "maxLength": 2048 }
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "adoption",
          "automation",
          "discovery",
          "operations",
          "training",
          "workflow-design"
        ]
      }
    },
    "availability": {
      "enum": [
        "available",
        "peer-exchange",
        "limited",
        "unavailable",
        "unknown"
      ]
    },
    "availabilityNote": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 280
    },
    "availabilityChecked": {
      "type": "string",
      "format": "date"
    },
    "workLocation": {
      "type": "string",
      "minLength": 2,
      "maxLength": 180
    },
    "availabilityDetail": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300
    },
    "contactEmail": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254
    },
    "site": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 12,
      "maxLength": 2048
    },
    "contact": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "url": {
            "type": "string",
            "minLength": 12,
            "maxLength": 2048
          }
        }
      }
    },
    "photo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.jpg$",
      "maxLength": 80
    },
    "listingConsent": {
      "$ref": "#/$defs/consent"
    },
    "copyApproved": {
      "$ref": "#/$defs/consent"
    },
    "photoApproved": {
      "$ref": "#/$defs/consent"
    },
    "publicationBasis": {
      "enum": [
        "person-approved",
        "public-sources-pending-review"
      ]
    }
  },
  "$defs": {
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "date",
        "policyVersion"
      ],
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "policyVersion": {
          "enum": [
            "r0-v1",
            "r0-v2"
          ]
        }
      }
    },
    "grantedConsent": {
      "allOf": [
        {
          "$ref": "#/$defs/consent"
        },
        {
          "properties": {
            "granted": {
              "const": true
            }
          }
        }
      ]
    },
    "notGrantedConsent": {
      "allOf": [
        {
          "$ref": "#/$defs/consent"
        },
        {
          "properties": {
            "granted": {
              "const": false
            }
          }
        }
      ]
    }
  }
}
