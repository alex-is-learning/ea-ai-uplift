{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaaiuplift.com/schema/profile-r0-v1.json",
  "title": "EA AI Uplift Release 0 profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "headline",
    "bio",
    "workMode",
    "organisation",
    "capabilities",
    "availability",
    "availabilityChecked",
    "site",
    "contact",
    "photo",
    "listingConsent",
    "copyApproved",
    "photoApproved"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "workMode": {
            "const": "independent"
          }
        },
        "required": [
          "workMode"
        ]
      },
      "then": {
        "properties": {
          "organisation": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "photo": {
            "type": "string"
          }
        },
        "required": [
          "photo"
        ]
      },
      "then": {
        "properties": {
          "photoApproved": {
            "$ref": "#/$defs/grantedConsent"
          }
        }
      },
      "else": {
        "properties": {
          "photoApproved": {
            "$ref": "#/$defs/notGrantedConsent"
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "r0-v1"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "bio": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "workMode": {
      "enum": [
        "in-house",
        "independent",
        "both"
      ]
    },
    "organisation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 140
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "adoption",
          "automation",
          "discovery",
          "operations",
          "training",
          "workflow-design"
        ]
      }
    },
    "availability": {
      "enum": [
        "available",
        "limited",
        "unavailable",
        "unknown"
      ]
    },
    "availabilityChecked": {
      "type": "string",
      "format": "date"
    },
    "site": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 12,
      "maxLength": 2048
    },
    "contact": {
      "type": "string",
      "minLength": 12,
      "maxLength": 2048
    },
    "photo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.jpg$",
      "maxLength": 80
    },
    "listingConsent": {
      "$ref": "#/$defs/grantedConsent"
    },
    "copyApproved": {
      "$ref": "#/$defs/grantedConsent"
    },
    "photoApproved": {
      "$ref": "#/$defs/consent"
    }
  },
  "$defs": {
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted",
        "date",
        "policyVersion"
      ],
      "properties": {
        "granted": {
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "policyVersion": {
          "const": "r0-v1"
        }
      }
    },
    "grantedConsent": {
      "allOf": [
        {
          "$ref": "#/$defs/consent"
        },
        {
          "properties": {
            "granted": {
              "const": true
            }
          }
        }
      ]
    },
    "notGrantedConsent": {
      "allOf": [
        {
          "$ref": "#/$defs/consent"
        },
        {
          "properties": {
            "granted": {
              "const": false
            }
          }
        }
      ]
    }
  }
}
